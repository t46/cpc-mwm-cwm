# === Slack App（共通、1つの App で共有）===
# Bot User OAuth Token（xoxb-...）
# 必要スコープ: channels:history, channels:read, users:read, chat:write, chat:write.customize, files:read, groups:history
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token（xapp-...）— MWM の Socket Mode 用。CWM のみ使う場合は不要
SLACK_APP_TOKEN=xapp-...

# === 共通 ===
ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=claude-sonnet-4-20250514

# === CWM（ホワイトペーパー生成）===
# WP 生成元の読み取り対象チャンネル（カンマ区切り）。bot の招待が必要
CWM_SOURCE_CHANNEL_IDS=C0XXXXXXXX,C0YYYYYYYY
# GitHub 公開用（--local モードなら不要）
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo

# === MWM（マルチエージェント議論 bot）===
# コマンド受付・bot 応答投稿先チャンネル。bot の招待が必要
MWM_BOT_CHANNEL_ID=C0XXXXXXXX
# ペルソナ定義ファイル（カンマ区切りで複数指定可）
PERSONA_FILES=personas/ada.md,personas/karl.md,personas/maya.md
# ホワイトペーパーファイルパス（省略可、指定するとペルソナに注入）
WHITEPAPER_PATH=
# 応答間隔（秒）
RESPONSE_INTERVAL_SECONDS=120
# 音声キャプチャ
ENABLE_AUDIO=false
AUDIO_DEVICE=BlackHole 2ch
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=ja
